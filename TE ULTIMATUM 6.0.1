function logT(m,s,c)lnC=lnC+1;local l=Q("TextLabel",TOut,{Size=UDim2.new(1,0,0,18),BackgroundTransparency=1,Font=Enum.Font.Code,TextSize=13,TextXAlignment="Left",LayoutOrder=lnC,ZIndex=1})if c then l.Text="  "..m;pcall(function()l.TextColor3=c end)elseif s==nil then l.Text="  "..m;pcall(function()l.TextColor3=Color3.fromRGB(150,150,170)end)else l.Text="  "..m..(s and " [OK]" or " [ERR]");pcall(function()l.TextColor3=s and Gr or Rd end)end task.wait(0.05);TOut.CanvasPosition=Vector2.new(0,99999);table.insert(UI.Lines,l)if #UI.Lines>200 then table.remove(UI.Lines,1):Destroy()end end
