local function Proc(inp)local c=string.lower(string.gsub(inp,"%s+"," "):match("^%s*(.-)%s*$"))if not c or c==""then return end local a={};for w in c:gmatch("%S+")do table.insert(a,w)end local m=a[1] if m=="help"then logT("help/clear/target/spd/status/exit",nil,Yl)elseif m=="clear"or m=="cls"then clearT();logT("Cleared.",true)elseif m=="target"then St.tgt=a[2]or"s";TgtLab.Text="TARGET: "..St.tgt:upper();logT("Target: "..St.tgt,true)elseif m=="speed"then St.flySpd=tonumber(a[2])or 50;logT("Speed: "..St.flySpd,true)elseif m=="exec"then local e=a[2];if e and Cmds[e]then St.Toggles[e]=not St.Toggles[e];local s=pcall(Cmds[e].cb);for _,b in pairs(UI.Btns)do if b.Name:lower()==e then Upd(b)end end;logT("Exec: "..e,s);Save()else logT("Unknown: "..tostring(e),false)end elseif m=="status"then logT("-- ACTIVE --",nil,P);local any=false;for n,s in pairs(St.Toggles)do if s then logT("[ON] "..n,nil,Gr);any=true end end if not any then logT("None",nil,Color3.fromRGB(100,100,120))end elseif m=="exit"then Main.Visible=false elseif Cmds[m]then St.Toggles[m]=not St.Toggles[m];local s=pcall(Cmds[m].cb);for _,b in pairs(UI.Btns)do if b.Name:lower()==m then Upd(b)end end;logT(m,s);Save()else logT("Unknown: "..m,false)end end
