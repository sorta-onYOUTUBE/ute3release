TIn.InputBegan:Connect(function(i)if i.KeyCode==Enum.KeyCode.Up then if St.hIdx>1 then St.hIdx=St.hIdx-1;TIn.Text=St.hist[St.hIdx]or""end elseif i.KeyCode==Enum.KeyCode.Down then if St.hIdx<#St.hist then St.hIdx=St.hIdx+1;TIn.Text=St.hist[St.hIdx]or""else St.hIdx=#St.hist+1;TIn.Text=""end end end)
