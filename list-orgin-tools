local function toggleInvis()
    invis_on = not invis_on
    local char = LocalPlayer.Character
    if not char then return end
    if invis_on then
        for _,v in pairs(char:GetDescendants()) do 
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then v.Transparency = 0.75 end 
        end
        local hr = char:FindFirstChild("HumanoidRootPart")
        if not hr then return end
        local saved = hr.CFrame
        char:MoveTo(seatPos)
        task.wait()
        if not char:FindFirstChild("HumanoidRootPart") or char.HumanoidRootPart.Position.Y < -50 then
            char:MoveTo(saved)
            invis_on = false
            for _,v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.Transparency = 0 end end
            return
        end
        local seat = Instance.new("Seat")
        seat.Parent = workspace
        seat.Anchored = false
        seat.CanCollide = false
        seat.Transparency = 1
        seat.Position = seatPos
        seat.Name = "invischair"
        local weld = Instance.new("Weld")
        weld.Part0 = seat
        weld.Parent = seat
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if torso then weld.Part1 = torso; task.wait(); seat.CFrame = saved end
    else
        for _,v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.Transparency = 0 end end
        if workspace:FindFirstChild("invischair") then workspace.invischair:Destroy() end
    end
end

