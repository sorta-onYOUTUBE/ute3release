local dragging, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
TopBar.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

table.insert(connections, RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char then
        if noclip_on or invis_on then
            for _,v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    pcall(function() v.CanCollide = false end)
                    if invis_on then
                        pcall(function() v.CanQuery = false end)
                        pcall(function() v.Massless = true end)
                    end
                end
            end
        end
        if invis_on then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        end
    end
end))

Players.PlayerAdded:Connect(function(player)
    player.CharacterRemoving:Connect(function(oldChar) removeForCharacter(oldChar, player) end)
    player.CharacterAdded:Connect(function(char)
        task.wait(1.2)
        if espEnabled then createForPlayer(player) end
    end)
    task.wait(1)
    if espEnabled then createForPlayer(player) end
    RefreshPlayerList()
end)
Players.PlayerRemoving:Connect(function(player)
    removeForCharacter(player.Character, player)
    if tracers[player] then pcall(function() tracers[player]:Remove() end) tracers[player] = nil end
    distCache[player] = nil
    if SelectedTargets[player.Name] then SelectedTargets[player.Name] = nil end
    RefreshPlayerList()
end)
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterRemoving:Connect(function(oldChar) removeForCharacter(oldChar, player) end)
        player.CharacterAdded:Connect(function(char)
            task.wait(1.2)
            if espEnabled then createForPlayer(player) end
        end)
        if player.Character and espEnabled then task.wait(0.5); createForPlayer(player) end
    end
end
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(2)
    if espEnabled then disableESP(); enableESP() end
    if not ScreenGui.Parent then ScreenGui.Parent = CoreGui end
end)

