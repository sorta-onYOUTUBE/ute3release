--[[
    ORGINS ESP — Sleek Black UI & Inventory Check
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- State
local espEnabled = false
local seeThroughEnabled = false
local invCheckEnabled = false
local transparencyBackup = {}
local descendantConn = nil
local renderConn = nil
local tracers = {}
local distCache = {}

---------------------------------------------------------------------------
-- Team color resolver (Yellow if no team)
---------------------------------------------------------------------------
local function getTeamColor(player)
    local myTeam = LocalPlayer.Team
    local theirTeam = player.Team
    if not theirTeam or not myTeam then return Color3.fromRGB(255, 230, 0) end -- Pure Yellow
    if myTeam == theirTeam then return Color3.fromRGB(0, 255, 100) end     -- Green
    if theirTeam.TeamColor then return theirTeam.TeamColor.Color end       -- Enemy Team Color
    return Color3.fromRGB(255, 60, 60) -- Fallback Red
end

---------------------------------------------------------------------------
-- Studs distance (Memory Cache)
---------------------------------------------------------------------------
local function getStuds(character)
    local myChar = LocalPlayer.Character
    if not myChar or not character then return nil end
    local myPos = myChar:FindFirstChild("HumanoidRootPart")
    if not myPos or not myPos:IsA("BasePart") then
        local s, p = pcall(function() return myChar:GetPivot().Position end)
        if not s or not p or p.Magnitude < 1 then return nil end
        myPos = {Position = p}
    end
    local theirPos = character:FindFirstChild("HumanoidRootPart")
    if not theirPos or not theirPos:IsA("BasePart") then
        local s, p = pcall(function() return character:GetPivot().Position end)
        if not s or not p or p.Magnitude < 1 then return nil end
        theirPos = {Position = p}
    end
    local dist = math.floor((myPos.Position - theirPos.Position).Magnitude)
    if dist == 0 then return nil end
    return dist
end

---------------------------------------------------------------------------
-- Inventory String Builder
---------------------------------------------------------------------------
local function getInventoryString(player)
    local items = {}
    if player.Character then
        for _, item in ipairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then table.insert(items, item.Name) end
        end
    end
    if player.Backpack then
        for _, item in ipairs(player.Backpack:GetChildren()) do
            if item:IsA("Tool") then table.insert(items, item.Name) end
        end
    end
    if #items == 0 then return nil end
    local str = table.concat(items, ", ")
    -- Truncate if too long to prevent UI breaking
    if #str > 50 then str = string.sub(str, 1, 50) .. "..." end
    return str
end

